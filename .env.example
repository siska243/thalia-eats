# Variables d'environnement du site.
#
# Ce fichier liste les NOMS, jamais les valeurs. Copiez-le en `.env.local`,
# qui n'est pas suivi par git, et renseignez-les la.

# Cloudflare Turnstile, le defi anti-robot (inscription, connexion, renvoi du
# code). La cle de site se cree sur dash.cloudflare.com > Turnstile ; la cle
# secrete, elle, va dans le .env du backend.
#
# VIDE = ETEINT : le widget ne s'affiche pas et les formulaires se comportent
# comme avant. C'est ce qui s'est passe jusqu'ici, sans que rien ne le dise.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# L'adresse du backend. Absente, le site vise 127.0.0.1:8000 en developpement
# et la production ailleurs (voir helpers/FetchData.js).
NEXT_PUBLIC_API_BASE_URL=

NEXT_PUBLIC_GOOGLE_MAPS_KEY=
